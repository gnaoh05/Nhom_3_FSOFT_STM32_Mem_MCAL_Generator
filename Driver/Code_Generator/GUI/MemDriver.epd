<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR_EPD version="4.4.0">
    <!-- Định nghĩa Module Memory Driver cho vi điều khiển STM32F401RE -->
    <Module name="MemDriver" vendor="FSoft_Automotive_Team" target="STM32F401RE">
        
        <!-- ========================================================== -->
        <!-- CONTAINER 1: MEM_GENERAL (Các cấu hình chung của Module)    -->
        <!-- ========================================================== -->
        <Container name="MemGeneral" description="General configuration parameters for MemDriver">
            <!-- Bật/tắt phát hiện lỗi trong quá trình phát triển (DET) -->
            <Parameter name="MemDevErrorDetect" type="BOOLEAN" default="true" 
                       description="Switches the Development Error Detection and Notification ON or OFF"/>
            
            <Parameter name="MemInvocation" type="ENUM" default="DIRECT_STATIC" options="DIRECT_STATIC,INDIRECT_DYNAMIC,INDIRECT_STATIC"
                       description="Invocation mode of the Mem driver"/>

            <Parameter name="MemMainFunctionPeriod" type="FLOAT" default="0.005" unit="S"
                       description="Period of the main function"/>
                       
            <!-- Kích thước bộ đệm trang ghi tối đa (Page Size theo Byte) -->
            <Parameter name="MemWritePageSize" type="INTEGER" min="1" max="128" default="4" unit="BYTES"
                       description="Size of a memory write page in bytes (STM32F4 word programming = 4 bytes)"/>
            
            <!-- Thời gian chờ tối đa cho thao tác xóa/ghi (Timeout theo mili-giây) -->
            <Parameter name="MemTimeoutDuration" type="INTEGER" min="10" max="5000" default="1000" unit="MS"
                       description="Timeout duration for flash erase and write operations"/>
        </Container>

        <!-- ========================================================== -->
        <!-- CONTAINER 2: MEM_INSTANCE (Cấu hình cụ thể cho khối Flash)  -->
        <!-- ========================================================== -->
        <Container name="MemInstance" description="Configuration of the flash memory instance">
            <Parameter name="MemInstanceId" type="INTEGER" min="0" max="255" default="0"
                       description="Unique ID of the memory instance"/>
            
            <Parameter name="MemBaseAddress" type="HEX" default="0x08000000"
                       description="Base address of the STM32F401RE Flash memory"/>
            
            <Parameter name="MemTotalSize" type="INTEGER" default="512" unit="KB" readonly="true"
                       description="Total flash memory size of STM32F401RE Nucleo"/>

            <!-- Danh sách Sector thực tế của STM32F401RE (RM0368) -->
            <!-- Tool CodeGen sẽ đọc danh sách này để hiển thị lên bảng Treeview trên GUI -->
            <List name="MemSectorBatch" description="List of physical flash sectors in STM32F401RE">
                <Item id="0" name="SECTOR_0" MemNumberOfSectors="1" MemEraseSectorSize="16384"  MemStartAddress="0x08000000" MemEndAddress="0x08003FFF" write_protect="false"/>
                <Item id="1" name="SECTOR_1" MemNumberOfSectors="1" MemEraseSectorSize="16384"  MemStartAddress="0x08004000" MemEndAddress="0x08007FFF" write_protect="false"/>
                <Item id="2" name="SECTOR_2" MemNumberOfSectors="1" MemEraseSectorSize="16384"  MemStartAddress="0x08008000" MemEndAddress="0x0800BFFF" write_protect="false"/>
                <Item id="3" name="SECTOR_3" MemNumberOfSectors="1" MemEraseSectorSize="16384"  MemStartAddress="0x0800C000" MemEndAddress="0x0800FFFF" write_protect="false"/>
                <Item id="4" name="SECTOR_4" MemNumberOfSectors="1" MemEraseSectorSize="65536"  MemStartAddress="0x08010000" MemEndAddress="0x0801FFFF" write_protect="false"/>
                <Item id="5" name="SECTOR_5" MemNumberOfSectors="1" MemEraseSectorSize="131072" MemStartAddress="0x08020000" MemEndAddress="0x0803FFFF" write_protect="false"/>
                <Item id="6" name="SECTOR_6" MemNumberOfSectors="1" MemEraseSectorSize="131072" MemStartAddress="0x08040000" MemEndAddress="0x0805FFFF" write_protect="false"/>
                <Item id="7" name="SECTOR_7" MemNumberOfSectors="1" MemEraseSectorSize="131072" MemStartAddress="0x08060000" MemEndAddress="0x0807FFFF" write_protect="false"/>
            </List>
        </Container>

        <!-- ========================================================== -->
        <!-- CONTAINER 3: MEM_API_CONFIG (Cấu hình các API được sinh ra)  -->
        <!-- ========================================================== -->
        <Container name="MemApiConfig" description="Enable or disable specific AUTOSAR APIs in generated code">
            <Parameter name="MemReadApi" type="BOOLEAN" default="true" description="Enable Mem_Read API"/>
            <Parameter name="MemWriteApi" type="BOOLEAN" default="true" description="Enable Mem_Write API"/>
            <Parameter name="MemEraseApi" type="BOOLEAN" default="true" description="Enable Mem_Erase API"/>
            <Parameter name="MemGetStatusApi" type="BOOLEAN" default="true" description="Enable Mem_GetStatus API"/>
        </Container>

    </Module>
</AUTOSAR_EPD>
