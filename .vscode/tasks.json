{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32 MCAL",
      "type": "shell",
      "command": "C:\\ST\\STM32CubeIDE_1.14.0\\STM32CubeIDE\\plugins\\com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.11.3.rel1.win32_1.1.100.202309141235\\tools\\bin\\arm-none-eabi-gcc.exe",
      "args": [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard",
        "-O0",
        "-g3",
        "-Wall",
        "-IDriver/include",
        "-ITest/Core",
        "-ITest/Stub/Det",
        "-ITest/Generated_File", // <-- Đã thêm thư mục chứa Flash_IP_Cfg.h
        "-T",
        "Test/Core/STM32F401RETx_FLASH.ld",
        "--specs=nano.specs",
        "--specs=nosys.specs",
        "Driver/src/Flash_IP.c",
        "Driver/src/Mem_IPW.c",
        "Test/Core/main.c",
        "Test/Stub/Det/det.c",
        "-o",
        "test_app.elf"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
