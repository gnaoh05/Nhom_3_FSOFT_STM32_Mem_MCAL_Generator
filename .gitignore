# 1. Thư mục rác của IDE (STM32CubeIDE / Eclipse)
.metadata/
.launches/
/.cproject
/.project
/.vscode

# 2. Thư mục chứa kết quả Build (không nên đẩy lên Git vì mỗi máy tự build được)
Debug/
Release/
build/

# 3. Các file trung gian và file thực thi sau khi biên dịch code
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.lst

# 4. File rác của hệ điều hành tự sinh ra
.DS_Store
Thumbs.db
desktop.ini

# 5. Cache Python của GUI/code generator
__pycache__/
*.py[cod]

# 6. Metadata tạm của CubeMX; file .ioc của board vẫn được quản lý bằng Git
.mxproject
