<?xml version="1.0" encoding="utf-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <!-- Stable BSW module definition. Project-specific values belong in EPC. -->
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR_ECUC</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-DEF UUID="2D5EE223-A2A8-5183-9E3A-2F5C65C1DE69">
          <SHORT-NAME>Mem</SHORT-NAME>
          <DESC>
            <L-2 L="EN">ECUC parameter definitions for the AUTOSAR Mem reference driver and STM32F401 internal Flash integration.</L-2>
          </DESC>
          <API-SERVICE-PREFIX>Mem</API-SERVICE-PREFIX>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="8E43C454-6195-5705-B17E-35BD01297363">
              <SHORT-NAME>MemGeneral</SHORT-NAME>
              <DESC><L-2 L="EN">General pre-compile configuration of the Mem module.</L-2></DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="F2646269-19A9-57CF-9574-86AEEFDFD78B">
                  <SHORT-NAME>MemDevErrorDetect</SHORT-NAME>
                  <DESC><L-2 L="EN">Enable development error detection.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="F6559FE1-0DED-5B52-8A74-0843DA26FE03">
                  <SHORT-NAME>MemVersionInfoApi</SHORT-NAME>
                  <DESC><L-2 L="EN">Enable the Mem_GetVersionInfo API.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="50A75E4A-A950-507C-83ED-C2F3DCDA3BA1">
                  <SHORT-NAME>MemIndex</SHORT-NAME>
                  <DESC><L-2 L="EN">Instance identifier passed to DET.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>255</MAX>
                  <MIN>0</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="3C7EEA50-E77C-5982-AED5-6FEA1928339B">
                  <SHORT-NAME>MemInvocation</SHORT-NAME>
                  <DESC><L-2 L="EN">Invocation method. The repository implementation supports DIRECT_STATIC.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>DIRECT_STATIC</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="A008A5F7-CA6D-5FD7-9B24-219EDBBA14E0">
                      <SHORT-NAME>DIRECT_STATIC</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="EC3E629C-B957-5CBA-A822-155C5B8AC2F2">
                      <SHORT-NAME>INDIRECT_STATIC</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="EAB3F96B-DDB8-5FEE-8401-3EFD2CADA9BA">
                      <SHORT-NAME>INDIRECT_DYNAMIC</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-FLOAT-PARAM-DEF UUID="ADAE8512-0C4C-597A-A51A-4036F1C3E3E6">
                  <SHORT-NAME>MemMainFunctionPeriod</SHORT-NAME>
                  <DESC><L-2 L="EN">Period of Mem_MainFunction in seconds.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>0.005</DEFAULT-VALUE>
                  <MIN>1e-06</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-FLOAT-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="B7C6387A-72B8-5A96-B716-8816E6D99EC2">
              <SHORT-NAME>MemInstance</SHORT-NAME>
              <DESC><L-2 L="EN">One Mem driver instance backed by internal Flash.</L-2></DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-INTEGER-PARAM-DEF UUID="CD5734B4-0DC5-5506-8E3C-8728222FE1A8">
                  <SHORT-NAME>MemInstanceId</SHORT-NAME>
                  <DESC><L-2 L="EN">Symbolic identifier of the single supported Mem instance.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>0</MAX>
                  <MIN>0</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="8908FE3B-EF71-544E-84AB-051D79D7F52A">
                  <SHORT-NAME>MemStartAddress</SHORT-NAME>
                  <DESC><L-2 L="EN">Start address of the memory instance.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>134217728</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>0</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="A0826C82-A62B-57B9-8BFF-97C134BB0576">
                  <SHORT-NAME>MemSize</SHORT-NAME>
                  <DESC><L-2 L="EN">Total size of the memory instance in bytes.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>524288</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>1</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
              </PARAMETERS>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="57CF9738-2002-57B4-9CDF-582B8E269078">
                  <SHORT-NAME>MemSectorBatch</SHORT-NAME>
                  <DESC><L-2 L="EN">Physical Flash sector geometry.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF UUID="103B4DF9-846B-584F-A228-12F2285C114F">
                      <SHORT-NAME>MemSectorStartAddress</SHORT-NAME>
                      <DESC><L-2 L="EN">Absolute start address of the Flash sector.</L-2></DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>134217728</DEFAULT-VALUE>
                      <MAX>4294967295</MAX>
                      <MIN>0</MIN>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="5B08CB4B-48FE-5441-B66A-BFE79BAC367B">
                      <SHORT-NAME>MemSectorSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Size of the Flash sector in bytes.</L-2></DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>16384</DEFAULT-VALUE>
                      <MAX>4294967295</MAX>
                      <MIN>1</MIN>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="EC811BC6-951C-5175-8028-62214AA4C895">
              <SHORT-NAME>MemPublishedInformation</SHORT-NAME>
              <DESC><L-2 L="EN">Published information of the configured memory.</L-2></DESC>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-INTEGER-PARAM-DEF UUID="8C7262C6-6C60-5033-9670-35F56963AFE1">
                  <SHORT-NAME>MemErasedValue</SHORT-NAME>
                  <DESC><L-2 L="EN">Value read from one erased memory cell.</L-2></DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <DEFAULT-VALUE>255</DEFAULT-VALUE>
                  <MAX>255</MAX>
                  <MIN>0</MIN>
                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
